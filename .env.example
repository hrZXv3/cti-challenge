# ─── abuse.ch (ThreatFox + URLhaus) — une seule clé pour les deux
# https://auth.abuse.ch/  → connexion → "Optional" → Auth-Key
ABUSECH_API_KEY=

# ─── VirusTotal — https://www.virustotal.com → profil → API Key
VT_API_KEY=

# ─── urlscan.io — https://urlscan.io/user/profile/ → API Keys
URLSCAN_API_KEY=

# ─── Shodan — https://account.shodan.io/
SHODAN_API_KEY=

# ─── Optionnels (plus tard dans le défi)
HUNTIO_API_KEY=
DISCORD_WEBHOOK_URL=        # J10
TELEGRAM_BOT_TOKEN=         # J24
